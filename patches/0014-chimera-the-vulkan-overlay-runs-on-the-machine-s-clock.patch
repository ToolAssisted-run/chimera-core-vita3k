+#ifdef CHIMERA
+        // chimera: the machine's clock, as the OpenGL overlay reads it. The
+        // host's clock stands still in the sandbox, and an animation timed
+        // by it never moves: a dialog that fades in stayed at nothing, with
+        // only its borders, which do not fade, to show for it (chimera issue
