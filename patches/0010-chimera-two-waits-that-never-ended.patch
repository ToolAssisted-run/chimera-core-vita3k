+void VoiceScheduler::strike(const Voice *voice) {
+    if (!walking)
+        return;
+    for (Voice *&walked : *walking) {
+        if (walked == voice)
+            walked = nullptr;
+    }
+}
+
+bool VoiceScheduler::still_walking(const Voice *voice) const {
+    return !walking || std::find(walking->begin(), walking->end(), voice) != walking->end();
+}
