+}
+
+// A state was loaded: every handle in here names an object of a context that
+// no longer exists. The buffers give their memory back (no call of theirs
+// reaches a driver while this runs - frame_host.h, vulkan_context_lost) and
+// every other handle is forgotten; what the application set - the viewport,
+// the scissor, the timestamps, the visibility buffers it declared - stays.
+void VKContext::chimera_drop() {
+    if (is_recording)
+        LOG_ERROR("A state was loaded in the middle of a scene: what it had drawn so far is lost");
+    is_recording = false;
+    in_renderpass = false;
+    is_in_query = false;
+    render_cmd = nullptr;
+    prerender_cmd = nullptr;
+    next_fence = nullptr;
+    cmdbuffers_to_submit.clear();
+
+    vertex_stream_ring_buffer.destroy();
+    index_stream_ring_buffer.destroy();
+    vertex_uniform_stream_ring_buffer.destroy();
+    fragment_uniform_stream_ring_buffer.destroy();
+    vertex_info_uniform_buffer.destroy();
+    fragment_info_uniform_buffer.destroy();
+    std::fill_n(vertex_stream_buffers, SCE_GXM_MAX_VERTEX_STREAMS, vk::Buffer{});
+
+    for (auto &[addr, vb] : visibility_buffers) {
+        vb.query_pool = nullptr;
+        vb.gpu_buffer = nullptr;
+    }
+
+    global_descriptor_pool = nullptr;
+    global_set = nullptr;
+    empty_set = nullptr;
+    rendertarget_set = nullptr;
+    last_vert_texture_count = ~0;
+    last_vert_texture_descriptor = nullptr;
+    last_frag_texture_count = ~0;
+    last_frag_texture_descriptor = nullptr;
+    for (int i = 0; i < SCE_GXM_MAX_TEXTURE_UNITS; i++) {
+        vertex_textures[i] = vk::DescriptorImageInfo{};
+        fragment_textures[i] = vk::DescriptorImageInfo{};
+    }
+
+    current_render_pass = nullptr;
+    current_shader_interlock_pass = nullptr;
+    current_pipeline = nullptr;
+    current_framebuffer = nullptr;
+    current_shader_interlock_framebuffer = nullptr;
+    current_color_base_image = nullptr;
+    current_color_view = nullptr;
+    current_ds_view = nullptr;
+    refresh_pipeline = true;
+
+    // the blocks the buffers held are gone with them: the next draw writes its own
+    memset(&prev_vert_ublock, 0, sizeof(shader::RenderVertUniformBlock));
+    memset(&prev_frag_ublock, 0, sizeof(shader::RenderFragUniformBlock));
+}
+
+void VKContext::chimera_make() {
+    make_objects();
+
+    for (auto &[addr, vb] : visibility_buffers) {
+        vk::QueryPoolCreateInfo pool_info{
+            .queryType = vk::QueryType::eOcclusion,
+            .queryCount = vb.size
+        };
+        vb.query_pool = state.device.createQueryPool(pool_info);
+        if (state.features.enable_memory_mapping)
+            std::tie(vb.gpu_buffer, vb.buffer_offset) = state.get_matching_mapping(Ptr<void>(vb.address));
+        vb.queries_used.assign(vb.queries_used.size(), false);
+    }
+    visibility_max_used_idx = -1;
+}
+
+void VKRenderTarget::chimera_drop() {
+    color.destroy();
+    color.layout = vkutil::ImageLayout::Undefined;
+    depthstencil.destroy();
+    depthstencil.layout = vkutil::ImageLayout::Undefined;
+    for (auto &fence : fences)
+        fence = nullptr;
+    for (int i = 0; i < MAX_FRAMES_RENDERING; i++) {
+        std::fill(cmd_buffers[i].begin(), cmd_buffers[i].end(), vk::CommandBuffer{});
+        std::fill(pre_cmd_buffers[i].begin(), pre_cmd_buffers[i].end(), vk::CommandBuffer{});
+    }
+}
+#endif
