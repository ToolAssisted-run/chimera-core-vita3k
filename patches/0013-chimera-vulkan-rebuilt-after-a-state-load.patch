+#ifdef CHIMERA
+// A core has no memory mapping, and a state has to hold every picture: once
+// the GPU has finished the scene (context.cpp, stop_recording), what
+// perform_surface_sync copied out of the surface is written to the machine's
+// memory, where the Vita's GPU would have drawn it. The same bytes upstream's
+// surface sync leaves there.
+void VKSurfaceCache::chimera_scene_to_memory(const MemState &mem, ColorSurfaceCacheInfo *surface) {
+    if (surface == nullptr || !surface->copy_buffer || !surface->copy_buffer->mapped_data)
+        return;
+
+    if (format_need_additional_memory(surface->format)) {
+        // converted on its way out of the buffer
+        perform_post_surface_sync(mem, surface);
+        return;
+    }
+
+    surface->copy_buffer->will_read();
+    memcpy(surface->data.cast<uint8_t>().get(mem), surface->copy_buffer->mapped_data,
+        static_cast<size_t>(surface->stride_bytes) * surface->original_height);
+
+    const bool is_swizzle_identity = surface->swizzle.r == vk::ComponentSwizzle::eR
+        || !format_support_swizzle(surface->format);
+    if (!is_swizzle_identity)
+        perform_post_surface_sync(mem, surface);
+}
+#endif
