+// state was loaded, and the host destroyed the device with everything made
+// on it. First the renderer lets go of all of it with its ordinary code -
+// which gives back the memory each object kept on this side, and of which
+// nothing reaches a driver, because the frame host is told the context is
+// lost before and until it is done - and then it makes the instance, the
+// device and every object again, as create and late_init did. What the GPU
+// had drawn comes back from the machine's memory: the core writes every
+// finished scene there (surface_cache.cpp, chimera_scene_to_memory), as the
+// Vita's GPU writes to its own, so a state holds every picture.
+void VKState::chimera_rebuild() {
+    LOG_INFO("The Vulkan context moved (a state was loaded): rebuilding every Vulkan object");
+    auto *frame_host = this->renderer::State::frame;
+    frame_host->vulkan_context_lost(true);
+    for (VKContext *c : live_contexts())
+        c->chimera_drop();
+    for (VKRenderTarget *rt : live_render_targets())
+        rt->chimera_drop();
+    destroy_objects();
+    frame_host->vulkan_context_lost(false);
+
+    std::unique_ptr<renderer::State> nobody;
