+#ifdef CHIMERA
+// In a core the GPU has finished a scene before the next is recorded
+// (stop_recording waits for it), so a ring buffer never holds more than one
+// scene's data at a time and can be far smaller than upstream's, which holds
+// three frames' worth. Smaller matters: through the sandbox every mapped
+// byte is a byte of the machine's memory, in every savestate and copied at
+// every load. What a scene must never do is ask for more than the buffer
+// holds - it would then draw from bytes it has itself overwritten - so that
+// is measured, and said.
+static vkutil::RingBuffer *ring_of(VKContext &c, int i) {
+    vkutil::RingBuffer *const rings[6] = {
+        &c.vertex_stream_ring_buffer, &c.index_stream_ring_buffer,
+        &c.vertex_uniform_stream_ring_buffer, &c.fragment_uniform_stream_ring_buffer,
+        &c.vertex_info_uniform_buffer, &c.fragment_info_uniform_buffer
+    };
+    return rings[i];
+}
+
+void VKContext::chimera_scene_begins() {
+    for (int i = 0; i < 6; i++)
+        chimera_scene_marks[i] = ring_of(*this, i)->total_allocated;
+}
+
+void VKContext::chimera_scene_ends() {
+    static const char *const names[6] = { "vertices", "indices", "vertex uniforms", "fragment uniforms", "vertex blocks", "fragment blocks" };
+    for (int i = 0; i < 6; i++) {
+        const vkutil::RingBuffer *ring = ring_of(*this, i);
+        const uint64_t asked = ring->total_allocated - chimera_scene_marks[i];
+        if (asked <= chimera_scene_peaks[i])
+            continue;
+        // said when the most a scene has asked for doubles, from 64 KiB up
+        const bool doubled = asked >= KiB(64) && asked >= 2 * std::max<uint64_t>(chimera_scene_peaks[i], KiB(32));
+        if (asked > ring->size())
+            LOG_ERROR("One scene asked for {} KiB of {} and the buffer holds {} KiB: part of it was drawn from overwritten data", asked / 1024, names[i], ring->size() / 1024);
+        else if (doubled)
+            LOG_INFO("The most one scene has asked for of {}: {} KiB of {} KiB", names[i], asked / 1024, ring->size() / 1024);
+        if (asked > ring->size() || doubled)
+            chimera_scene_peaks[i] = asked;
+    }
+}
+#endif
