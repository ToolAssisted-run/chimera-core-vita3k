+#ifdef CHIMERA
+void GLState::chimera_check_context() {
+    const uint64_t id = frame->context_id();
+    if (id == 0 || id == chimera_context)
+        return;
+    if (chimera_context != 0)
+        chimera_rebuild();
+    chimera_context = id;
+}
+
+// Every GL object this renderer remembers belongs to another context: a
+// state was loaded. First every one is dropped - which deletes only names
+// this machine remembers, before a single new name is made, so a delete can
+// never land on a name the new objects were given - and then they are all
+// made again. Sync objects are forgotten, not deleted (fence.h). What the GPU
+// drew comes back from memory: the core keeps surface sync on, so every scene
+// the GPU finishes is written to the machine's memory, as the Vita's GPU
+// writes to its own, and a state holds every picture.
+void GLState::chimera_rebuild() {
+    LOG_INFO("The GL context moved (a state was loaded): rebuilding every GL object");
+    g_fence_forget = true;
+    program_cache.clear();
+    fragment_shader_cache.clear();
+    vertex_shader_cache.clear();
+    texture_cache.cleanup();
+    surface_cache.cleanup();
+    screen_renderer.destroy();
+    overlay_renderer.destroy();
+    for (GLContext *c : live_contexts())
+        c->chimera_drop();
+    for (GLRenderTarget *rt : live_render_targets()) {
+        rt->maskbuffer.cleanup();
+        rt->masktexture.cleanup();
+        rt->attachments.cleanup();
+    }
+    frame->lost_context();
+    g_fence_forget = false;
+
+    screen_renderer.init(static_assets);
+    overlay_renderer.init(static_assets, vita_fs_path, sys_lang);
+    texture_cache.init(chimera_hashless, texture_folder(), chimera_game_id);
+    for (GLContext *c : live_contexts())
+        c->chimera_make();
+    for (GLRenderTarget *rt : live_render_targets())
+        make_render_target_objects(*this, rt);
 }
+#endif
 
