+    new (&fragment_info_uniform_buffer) RingBuffer(GL_UNIFORM_BUFFER, MiB(8));
+    vertex_array.init(glGenVertexArrays, glDeleteVertexArrays);
+    std::memset(&previous_vert_info, 0, sizeof(shader::RenderVertUniformBlock));
