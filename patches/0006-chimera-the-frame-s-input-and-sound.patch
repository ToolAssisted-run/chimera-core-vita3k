new file mode 100644
--- /dev/null
+++ b/vita3k/chimera/include/chimera/input.h
@@ -0,0 +1,26 @@
+// Chimera: the frame's input. The core sets it before each frame, in the
+// Vita's own units, and everything the machine reads input from - the pad,
+// both touch panels, the motion sensors, the system dialogs - reads it here,
+// so a frame sees exactly the input it was given and nothing of the host.
+#pragma once
+
+#include <cstdint>
+
+namespace chimera {
+
+struct FrameInput {
+    uint32_t buttons = 0; // SCE_CTRL_* as sceCtrlPeekBufferPositive reports them
+    uint32_t buttons_ext = 0; // the same as the 2/Ext2 reads report them (L1/R1)
+    uint8_t lx = 128, ly = 128, rx = 128, ry = 128; // 0..255, 128 centred
+    // per panel (0 front, 1 rear): a finger, where, in the panel's units
+    bool touch_down[2] = {};
+    uint16_t touch_x[2] = {}, touch_y[2] = {};
+    float accel[3] = { 0.0f, 0.0f, -1.0f }; // g; lying face up reads -1 on z
+    float gyro[3] = {}; // revolutions a second (Vita3K's unit)
+    // set when the machine reads any of it during the frame
+    bool read = false;
+};
+
+FrameInput &frame_input();
+
+} // namespace chimera
