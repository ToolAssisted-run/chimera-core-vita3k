+// but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+// GNU General Public License for more details.
+//
+// You should have received a copy of the GNU General Public License along
+// with this program; if not, write to the Free Software Foundation, Inc.,
+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+#include <audio/impl/chimera_audio.h>
+
+#include <chimera/vsched.h>
+
+#include <algorithm>
+#include <cstring>
+
+// at most this much unread sound is kept (a frontend that never takes it
+// must not grow the machine without bound): one second at 48 kHz stereo
+static constexpr size_t MAX_KEPT_SAMPLES = 48000 * 2;
+
+AudioOutPortPtr ChimeraAudioAdapter::open_port(int nb_channels, int freq, int nb_sample) {
+    auto port = std::make_shared<ChimeraAudioOutPort>();
+    port->channels = nb_channels;
+    port->play_until = vsched_now_ns();
+    return port;
+}
+
+// The hardware double-buffers: an output returns once the buffer before it
+// has started playing, that is when no more than one buffer is queued.
+void ChimeraAudioAdapter::audio_output(AudioOutPort &out_port, const void *buffer) {
+    auto &port = static_cast<ChimeraAudioOutPort &>(out_port);
+    const uint64_t buffer_ns = port.len_microseconds * 1000;
+    for (;;) {
+        if (port.stopping)
+            return;
+        const uint64_t now = vsched_now_ns();
+        if (port.play_until <= now + buffer_ns)
+            break;
+        const vsched_wait_item item = { &port.wake_seq, port.wake_seq };
+        vsched_wait_until(&item, 1, port.play_until - buffer_ns);
+    }
+    const uint64_t now = vsched_now_ns();
+    port.play_until = std::max(port.play_until, now) + buffer_ns;
+
+    const size_t samples = static_cast<size_t>(port.len_bytes) / sizeof(int16_t);
+    const int16_t *in = static_cast<const int16_t *>(buffer);
+    for (size_t i = 0; i < samples; i++)
+        port.played.push_back(static_cast<int16_t>(std::clamp(static_cast<int>(in[i] * port.gain), -32768, 32767)));
+    while (port.played.size() > MAX_KEPT_SAMPLES)
+        port.played.pop_front();
+}
+
+void ChimeraAudioAdapter::set_volume(AudioOutPort &out_port, float volume) {
+    static_cast<ChimeraAudioOutPort &>(out_port).gain = volume;
+}
+
+int ChimeraAudioAdapter::get_rest_sample(AudioOutPort &out_port) {
+    auto &port = static_cast<ChimeraAudioOutPort &>(out_port);
+    const uint64_t now = vsched_now_ns();
+    if (port.play_until <= now || port.freq <= 0)
+        return 0;
+    return static_cast<int>((port.play_until - now) * static_cast<uint64_t>(port.freq) / 1000000000ull);
+}
+
+void ChimeraAudioAdapter::wake_all_ports() {
+    for (auto &[_, port_ptr] : state.out_ports) {
+        auto &port = static_cast<ChimeraAudioOutPort &>(*port_ptr);
+        port.wake_seq++;
+        vsched_notify(&port.wake_seq, 1);
+    }
+}
