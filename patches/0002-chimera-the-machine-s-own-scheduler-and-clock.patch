+++ b/vita3k/chimera/CMakeLists.txt
@@ -0,0 +1,12 @@
+# Chimera: the machine's own scheduler and clock (vsched), and the C++ sync
+# types the emulator uses in place of the host's. Built only with
+# CHIMERA_HEADLESS; everything that links util sees CHIMERA defined.
+add_library(chimera STATIC
+	include/chimera/sync.h
+	include/chimera/vsched.h
+	src/vsched.cpp
+)
+target_include_directories(chimera PUBLIC include)
+target_compile_definitions(chimera PUBLIC CHIMERA=1)
+find_package(Threads REQUIRED)
+target_link_libraries(chimera PUBLIC Threads::Threads)
diff --git a/vita3k/chimera/include/chimera/sync.h b/vita3k/chimera/include/chimera/sync.h
new file mode 100644
--- /dev/null
+++ b/vita3k/chimera/include/chimera/sync.h
@@ -0,0 +1,217 @@
+// The machine's threads, clock and waits, shaped like the standard library's
+// so the emulator's code keeps its shape: every one of them goes through
+// vsched, so a wait parks a thread in virtual time and a notify hands the
+// machine on deterministically.
+//
+// chimera::condition_variable takes only vclock deadlines: a host-clock
+// deadline left anywhere is a compile error, not a quiet source of drift.
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <chimera/vsched.h>
+
+#include <pthread.h>
+
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <exception>
+#include <system_error>
+#include <functional>
+#include <memory>
+#include <tuple>
+#include <utility>
+
+namespace chimera {
+
+// Virtual time since the machine started (vsched_now_ns).
+struct vclock {
+    using rep = int64_t;
+    using period = std::nano;
+    using duration = std::chrono::nanoseconds;
+    using time_point = std::chrono::time_point<vclock>;
+    static constexpr bool is_steady = true;
+    static time_point now() noexcept {
+        return time_point(duration(static_cast<rep>(vsched_now_ns())));
+    }
+};
+
+inline uint64_t to_vsched(vclock::time_point tp) {
+    if (tp == vclock::time_point::max())
+        return VSCHED_INFINITE;
+    const auto ns = tp.time_since_epoch().count();
+    return ns < 0 ? 0 : static_cast<uint64_t>(ns);
+}
+
+template <class Rep, class Period>
+inline uint64_t to_vsched(std::chrono::duration<Rep, Period> d) {
+    if (d <= d.zero())
+        return 0;
+    if (d >= std::chrono::duration_cast<std::chrono::duration<Rep, Period>>(std::chrono::nanoseconds::max()))
+        return VSCHED_INFINITE;
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(d).count());
+}
+
+template <class Rep, class Period>
+inline void sleep_for(std::chrono::duration<Rep, Period> d) {
+    vsched_sleep(to_vsched(d));
+}
+
+inline void sleep_until(vclock::time_point tp) {
+    vsched_sleep_until(to_vsched(tp));
+}
+
+inline void yield() {
+    vsched_yield_default();
+}
+
+class condition_variable {
+public:
+    condition_variable() = default;
+    condition_variable(const condition_variable &) = delete;
+    condition_variable &operator=(const condition_variable &) = delete;
+
+    void notify_one() noexcept {
+        seq++;
+        vsched_notify(&seq, 0);
+    }
+    void notify_all() noexcept {
+        seq++;
+        vsched_notify(&seq, 1);
+    }
+
+    template <class Lock>
+    void wait(Lock &lock) {
+        park(lock, VSCHED_INFINITE);
+    }
+    template <class Lock, class Pred>
+    void wait(Lock &lock, Pred pred) {
+        while (!pred())
+            park(lock, VSCHED_INFINITE);
+    }
+
+    template <class Lock>
+    std::cv_status wait_until(Lock &lock, vclock::time_point tp) {
+        return park(lock, to_vsched(tp)) ? std::cv_status::timeout : std::cv_status::no_timeout;
+    }
+    template <class Lock, class Pred>
+    bool wait_until(Lock &lock, vclock::time_point tp, Pred pred) {
+        while (!pred())
+            if (wait_until(lock, tp) == std::cv_status::timeout)
+                return pred();
+        return true;
+    }
+
+    template <class Lock, class Rep, class Period>
+    std::cv_status wait_for(Lock &lock, std::chrono::duration<Rep, Period> d) {
+        return wait_until(lock, deadline_after(d));
+    }
+    template <class Lock, class Rep, class Period, class Pred>
+    bool wait_for(Lock &lock, std::chrono::duration<Rep, Period> d, Pred pred) {
+        return wait_until(lock, deadline_after(d), std::move(pred));
+    }
+
+private:
+    template <class Rep, class Period>
+    static vclock::time_point deadline_after(std::chrono::duration<Rep, Period> d) {
+        const uint64_t ns = to_vsched(d);
+        if (ns == VSCHED_INFINITE)
+            return vclock::time_point::max();
+        return vclock::now() + std::chrono::nanoseconds(static_cast<int64_t>(ns));
+    }
+
+    // Unlock, park on seq (a notify moves it), lock again. Only one thread
+    // runs at a time, so nothing can slip between the unlock and the park.
+    template <class Lock>
+    int park(Lock &lock, uint64_t deadline) {
+        const vsched_wait_item item = { &seq, seq };
+        lock.unlock();
+        const int timed_out = vsched_wait_until(&item, 1, deadline);
+        lock.lock();
+        return timed_out;
+    }
+
+    uint32_t seq = 0;
+};
+
+// A machine thread: scheduled by vsched from the moment it is made, joined
+// in virtual time.
+class thread {
+public:
+    thread() noexcept = default;
+
+    template <class F, class... Args>
+    explicit thread(F &&f, Args &&...args) {
+        auto st = std::make_shared<state>();
+        st->fn = [f = std::decay_t<F>(std::forward<F>(f)), tup = std::make_tuple(std::decay_t<Args>(std::forward<Args>(args))...)]() mutable {
+            std::apply([&](auto &...a) { std::invoke(f, a...); }, tup);
+        };
+        auto *arg = new std::shared_ptr<state>(st);
+        if (vsched_create(&pt, &entry, arg) != 0) {
+            delete arg;
+            throw std::system_error(std::make_error_code(std::errc::resource_unavailable_try_again));
+        }
+        s = std::move(st);
+    }
+
+    thread(thread &&o) noexcept
+        : s(std::move(o.s))
+        , pt(o.pt) {
+        o.pt = 0;
+    }
+    thread &operator=(thread &&o) noexcept {
+        if (joinable())
+            std::terminate();
+        s = std::move(o.s);
+        pt = o.pt;
+        o.pt = 0;
+        return *this;
+    }
+    thread(const thread &) = delete;
+    thread &operator=(const thread &) = delete;
+
+    ~thread() {
+        if (joinable())
+            std::terminate();
+    }
+
+    bool joinable() const noexcept {
+        return s != nullptr;
+    }
+
+    // In virtual time until the thread has left the machine, then the host
+    // thread itself, which by then has nothing left to do but end.
+    void join() {
+        while (!s->done) {
+            const vsched_wait_item item = { &s->done, 0 };
+            vsched_wait(&item, 1, VSCHED_INFINITE);
+        }
+        pthread_join(static_cast<pthread_t>(pt), nullptr);
+        s.reset();
+    }
+
+    void detach() {
+        pthread_detach(static_cast<pthread_t>(pt));
+        s.reset();
+    }
+
+private:
+    struct state {
+        std::function<void()> fn;
+        uint32_t done = 0;
+    };
+
+    static void *entry(void *p) {
+        std::shared_ptr<state> st = std::move(*static_cast<std::shared_ptr<state> *>(p));
+        delete static_cast<std::shared_ptr<state> *>(p);
+        st->fn();
+        st->done = 1;
+        vsched_notify(&st->done, 1);
+        return nullptr;
+    }
+
+    std::shared_ptr<state> s;
+    unsigned long pt = 0;
+};
+
+} // namespace chimera
diff --git a/vita3k/chimera/include/chimera/vsched.h b/vita3k/chimera/include/chimera/vsched.h
new file mode 100644
--- /dev/null
+++ b/vita3k/chimera/include/chimera/vsched.h
@@ -0,0 +1,98 @@
+// vsched: the virtual-time scheduler that owns every one of the machine's
+// threads (ported from chimera-core-rpcs3). One thread runs at a time; the
+// running thread hands off explicitly; virtual time advances by what the
+// machine charges (the CPU's instructions, yields) and jumps to the next
+// deadline when nothing is runnable. Plain pthreads + semaphores in both
+// flavours, so the native build follows exactly the schedule the sandbox
+// follows.
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define VSCHED_INFINITE UINT64_MAX
+
+typedef void *(*vsched_entry_fn)(void *);
+
+typedef struct vsched_wait_item {
+    const void *addr;
+    uint32_t old;
+} vsched_wait_item;
+
+// The calling thread becomes thread 0 (the driver). Call once, first.
+void vsched_init(void);
+// true once vsched_init ran: before it (static initialisers) every call is a
+// no-op, as nothing could be scheduled
+int vsched_active(void);
+
+// A pthread that starts parked and runs only when scheduled; threads are
+// scheduled round robin in creation order. `out_pthread` receives the
+// pthread_t so the caller can join it once it is done.
+int vsched_create(unsigned long *out_pthread, vsched_entry_fn fn, void *arg);
+
+// The current thread leaves the machine (does not return).
+void vsched_exit(void);
+
+// Virtual time in nanoseconds since the machine started. It starts at one
+// second: the emulator treats a zero time as "not yet" in places.
+uint64_t vsched_now_ns(void);
+#define VSCHED_START_NS 1000000000ull
+
+// The machine's calendar: Unix seconds at the moment the machine started,
+// carried forward by virtual time. The host's date is never the console's.
+void vsched_set_calendar_start(uint64_t unix_seconds);
+uint64_t vsched_calendar_us(void);
+
+// Charge virtual time without giving way.
+void vsched_advance(uint64_t ns);
+
+// Charge virtual time and give way to the next runnable thread, if any.
+void vsched_yield(uint64_t cost_ns);
+// a yield at the fixed yield cost, for the emulator's spin-and-yield sites
+void vsched_yield_default(void);
+
+// Park until one of the addresses is notified, its value already differs
+// from `old`, or the timeout elapses. Returns 1 on timeout, 0 otherwise;
+// callers re-check their condition either way (futex semantics).
+int vsched_wait(const vsched_wait_item *items, int n, uint64_t timeout_ns);
+// the same with an absolute deadline in virtual time
+int vsched_wait_until(const vsched_wait_item *items, int n, uint64_t deadline_ns);
+
+// Wake the longest-waiting thread (or every thread) parked on `addr`.
+void vsched_notify(const void *addr, int all);
+
+// Park for a duration of virtual time, or until a moment of it.
+void vsched_sleep(uint64_t ns);
+void vsched_sleep_until(uint64_t deadline_ns);
+
+// The CPU: instructions become time at the machine's rate, and a thread
+// gives way after a slice of them. vsched_cpu_charge is dynarmic's AddTicks,
+// vsched_cpu_remaining its GetTicksRemaining; a JIT that ran out calls
+// vsched_cpu_slice_over.
+void vsched_set_cpu_hz(uint64_t hz);
+uint64_t vsched_cpu_hz(void);
+void vsched_cpu_charge(uint64_t instructions);
+uint64_t vsched_cpu_remaining(void);
+void vsched_cpu_slice_over(void);
+
+// Thread-local storage without ELF TLS: every thread owns a slot in
+// [0, VSCHED_SLOTS) for its whole life (slots are reused after exit).
+// Resetters registered here run for a slot whenever a thread is born into it
+// (and once for slot 0 at registration).
+#define VSCHED_SLOTS 256
+int vsched_slot(void);
+void vsched_register_slot_reset(void (*fn)(int slot));
+void vsched_register_thread_exit(void (*fn)(int slot));
+
+// Diagnostics.
+int vsched_thread_count(void);
+uint32_t vsched_current_id(void);
+uint64_t vsched_switch_count(void);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/vita3k/chimera/src/vsched.cpp b/vita3k/chimera/src/vsched.cpp
new file mode 100644
--- /dev/null
+++ b/vita3k/chimera/src/vsched.cpp
@@ -0,0 +1,415 @@
+// vsched: see vsched.h. The machine's own scheduler, host-agnostic.
+// SPDX-License-Identifier: MIT
+#include <chimera/vsched.h>
+
+#include <pthread.h>
+#include <semaphore.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <xmmintrin.h>
+
+// The costs that make virtual time out of work. These constants are the
+// machine; movies cite the core version, and the core version pins them.
+//
+// The CPU: three cores' worth of a 444 MHz Cortex-A9 at one instruction a
+// cycle, as one timeline. Every guest thread runs on it in turn, so a game
+// that keeps three cores busy gets the throughput it had; one that keeps one
+// busy idles more, which a vsync-locked game never shows.
+static const uint64_t DEFAULT_CPU_HZ = 1332000000ull;
+static const uint64_t CPU_SLICE = 100000;  // instructions before a thread gives way
+static const uint64_t YIELD_COST_NS = 1000;
+static const size_t THREAD_STACK_BYTES = 8u << 20;
+
+enum state_t {
+    RUNNABLE,
+    WAITING,
+    DEAD,
+};
+
+struct vthread {
+    sem_t sem;
+    pthread_t pt;
+    uint32_t id;
+    state_t state;
+    uint64_t deadline; // VSCHED_INFINITE when not timed
+    uint64_t wait_seq; // FIFO order among waiters
+    const vsched_wait_item *items;
+    int nitems;
+    int timed_out;
+    uint32_t mxcsr;
+    uint16_t fcw;
+    vsched_entry_fn fn;
+    void *arg;
+    int slot;
+    vthread *next; // creation-order ring
+};
+
+static vthread *g_head; // first created (the driver)
+static vthread *g_tail;
+static vthread *g_cur;
+static uint64_t g_now;
+static uint32_t g_next_id;
+static uint64_t g_wait_seq;
+static uint64_t g_switches;
+static int g_count;
+
+// 2013-01-01 00:00:00 UTC until the driver says otherwise
+static uint64_t g_calendar_start = 1356998400ull;
+
+static uint64_t g_cpu_hz = DEFAULT_CPU_HZ;
+static uint64_t g_cpu_frac; // nanoseconds * hz not yet charged
+static uint64_t g_slice_left = CPU_SLICE;
+
+[[noreturn]] static void die(const char *what) {
+    fprintf(stderr, "vsched: %s (now=%llu ns, threads=%d)\n", what, (unsigned long long)g_now, g_count);
+    for (vthread *t = g_head; t; t = t->next)
+        fprintf(stderr, "  thread %u: %s deadline=%llu items=%d\n", t->id,
+            t->state == RUNNABLE ? "runnable" : t->state == WAITING ? "waiting"
+                                                                     : "dead",
+            (unsigned long long)t->deadline, t->nitems);
+    fflush(stderr);
+    abort();
+}
+
+static bool g_slot_used[VSCHED_SLOTS];
+static void (*g_slot_resets[1024])(int);
+static int g_slot_reset_count;
+static void (*g_thread_exits[64])(int);
+static int g_thread_exit_count;
+
+static int take_slot(void) {
+    for (int i = 0; i < VSCHED_SLOTS; i++)
+        if (!g_slot_used[i]) {
+            g_slot_used[i] = true;
+            for (int r = 0; r < g_slot_reset_count; r++)
+                g_slot_resets[r](i);
+            return i;
+        }
+    die("out of thread slots");
+}
+
+static void fpu_save(vthread *t) {
+    t->mxcsr = _mm_getcsr();
+    __asm__ volatile("fnstcw %0" : "=m"(t->fcw));
+}
+
+static void fpu_restore(const vthread *t) {
+    _mm_setcsr(t->mxcsr);
+    __asm__ volatile("fldcw %0" : : "m"(t->fcw));
+}
+
+// Wake every timed waiter whose deadline has passed.
+static void wake_expired(void) {
+    for (vthread *t = g_head; t; t = t->next)
+        if (t->state == WAITING && t->deadline <= g_now) {
+            t->state = RUNNABLE;
+            t->timed_out = 1;
+        }
+}
+
+// The next runnable thread after `from` in ring order, or null.
+static vthread *next_runnable_after(vthread *from) {
+    vthread *t = from->next ? from->next : g_head;
+    for (int i = 0; i < g_count; i++) {
+        if (t->state == RUNNABLE)
+            return t;
+        t = t->next ? t->next : g_head;
+    }
+    return nullptr;
+}
+
+// When nothing is runnable, time jumps to the earliest deadline.
+static void advance_to_next_deadline(void) {
+    uint64_t best = VSCHED_INFINITE;
+    for (vthread *t = g_head; t; t = t->next)
+        if (t->state == WAITING && t->deadline < best)
+            best = t->deadline;
+    if (best == VSCHED_INFINITE)
+        die("every thread is waiting forever");
+    if (best > g_now)
+        g_now = best;
+    wake_expired();
+}
+
+// Hand the machine to `t` and park until scheduled again.
+static void switch_to(vthread *t) {
+    vthread *self = g_cur;
+    if (t == self)
+        return;
+    fpu_save(self);
+    g_cur = t;
+    g_switches++;
+    g_slice_left = CPU_SLICE;
+    sem_post(&t->sem);
+    while (sem_wait(&self->sem) != 0) {
+    }
+    if (g_cur != self)
+        die("the baton was duplicated: a thread resumed without being scheduled");
+    fpu_restore(self);
+}
+
+// The current thread is no longer runnable: find who runs next.
+static void schedule_away(void) {
+    vthread *self = g_cur;
+    for (;;) {
+        wake_expired();
+        vthread *t = next_runnable_after(self);
+        if (t) {
+            switch_to(t);
+            return;
+        }
+        if (self->state == RUNNABLE)
+            return; // only we can run: keep running
+        advance_to_next_deadline();
+    }
+}
+
+static void *trampoline(void *p) {
+    vthread *t = (vthread *)p;
+    while (sem_wait(&t->sem) != 0) {
+    }
+    if (g_cur != t)
+        die("the baton was duplicated: a new thread started without being scheduled");
+    fpu_restore(t);
+    t->fn(t->arg);
+    vsched_exit();
+    return nullptr;
+}
+
+void vsched_init(void) {
+    vthread *t = (vthread *)calloc(1, sizeof(vthread));
+    sem_init(&t->sem, 0, 0);
+    t->pt = pthread_self();
+    t->id = g_next_id++;
+    t->state = RUNNABLE;
+    t->deadline = VSCHED_INFINITE;
+    t->slot = take_slot(); // slot 0: its resetters already ran at registration
+    fpu_save(t);
+    g_head = g_tail = g_cur = t;
+    g_count = 1;
+    g_now = VSCHED_START_NS;
+}
+
+int vsched_active(void) {
+    return g_cur != nullptr;
+}
+
+int vsched_create(unsigned long *out_pthread, vsched_entry_fn fn, void *arg) {
+    if (!g_cur)
+        die("a thread was made before the machine (vsched_init)");
+    vthread *t = (vthread *)calloc(1, sizeof(vthread));
+    sem_init(&t->sem, 0, 0);
+    t->id = g_next_id++;
+    t->state = RUNNABLE;
+    t->deadline = VSCHED_INFINITE;
+    t->fn = fn;
+    t->arg = arg;
+    t->slot = take_slot();
+    // a new thread starts with the machine's default FPU state, not the
+    // creator's
+    t->mxcsr = 0x1f80;
+    t->fcw = 0x37f;
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, THREAD_STACK_BYTES);
+    int rc = pthread_create(&t->pt, &attr, trampoline, t);
+    pthread_attr_destroy(&attr);
+    if (rc != 0) {
+        g_slot_used[t->slot] = false;
+        sem_destroy(&t->sem);
+        free(t);
+        return rc;
+    }
+    g_tail->next = t;
+    g_tail = t;
+    g_count++;
+    if (out_pthread)
+        memcpy(out_pthread, &t->pt, sizeof(pthread_t));
+    return 0;
+}
+
+void vsched_exit(void) {
+    vthread *self = g_cur;
+    if (self == g_head)
+        die("the driver thread tried to exit");
+    for (int i = 0; i < g_thread_exit_count; i++)
+        g_thread_exits[i](self->slot);
+    self->state = DEAD;
+    g_slot_used[self->slot] = false;
+    // unlink
+    vthread *prev = g_head;
+    while (prev->next != self)
+        prev = prev->next;
+    prev->next = self->next;
+    if (g_tail == self)
+        g_tail = prev;
+    g_count--;
+    // choose the successor the way schedule_away would, starting after prev
+    vthread *t = nullptr;
+    for (;;) {
+        wake_expired();
+        t = next_runnable_after(prev);
+        if (t)
+            break;
+        advance_to_next_deadline();
+    }
+    g_cur = t;
+    g_switches++;
+    g_slice_left = CPU_SLICE;
+    sem_post(&t->sem);
+    // the thread struct outlives us until nobody can name it; leak it
+    // deliberately (a few hundred bytes per thread ever created)
+    pthread_exit(nullptr);
+}
+
+uint64_t vsched_now_ns(void) {
+    return g_now;
+}
+
+void vsched_set_calendar_start(uint64_t unix_seconds) {
+    g_calendar_start = unix_seconds;
+}
+
+uint64_t vsched_calendar_us(void) {
+    const uint64_t since = (g_cur ? g_now : VSCHED_START_NS) - VSCHED_START_NS;
+    return g_calendar_start * 1000000ull + since / 1000ull;
+}
+
+void vsched_advance(uint64_t ns) {
+    g_now += ns;
+}
+
+void vsched_yield(uint64_t cost_ns) {
+    if (!g_cur)
+        return; // before the machine exists (static initialisers), a yield is nothing
+    g_now += cost_ns;
+    wake_expired();
+    vthread *t = next_runnable_after(g_cur);
+    if (t)
+        switch_to(t);
+    else
+        g_slice_left = CPU_SLICE;
+}
+
+void vsched_yield_default(void) {
+    vsched_yield(YIELD_COST_NS);
+}
+
+int vsched_wait_until(const vsched_wait_item *items, int n, uint64_t deadline_ns) {
+    if (!g_cur)
+        return 0; // static initialisers may not park: nobody could wake them
+    for (int i = 0; i < n; i++)
+        if (*(const volatile uint32_t *)items[i].addr != items[i].old)
+            return 0;
+    if (deadline_ns <= g_now)
+        return 1;
+    vthread *self = g_cur;
+    self->items = items;
+    self->nitems = n;
+    self->timed_out = 0;
+    self->wait_seq = ++g_wait_seq;
+    self->deadline = deadline_ns;
+    self->state = WAITING;
+    schedule_away();
+    self->state = RUNNABLE;
+    self->items = nullptr;
+    self->nitems = 0;
+    self->deadline = VSCHED_INFINITE;
+    return self->timed_out;
+}
+
+int vsched_wait(const vsched_wait_item *items, int n, uint64_t timeout_ns) {
+    const uint64_t deadline = timeout_ns == VSCHED_INFINITE || timeout_ns > VSCHED_INFINITE - g_now
+        ? VSCHED_INFINITE
+        : g_now + timeout_ns;
+    return vsched_wait_until(items, n, deadline);
+}
+
+void vsched_notify(const void *addr, int all) {
+    for (;;) {
+        vthread *best = nullptr;
+        for (vthread *t = g_head; t; t = t->next) {
+            if (t->state != WAITING)
+                continue;
+            for (int i = 0; i < t->nitems; i++)
+                if (t->items[i].addr == addr) {
+                    if (!best || t->wait_seq < best->wait_seq)
+                        best = t;
+                    break;
+                }
+        }
+        if (!best)
+            return;
+        best->state = RUNNABLE;
+        best->timed_out = 0;
+        if (!all)
+            return;
+    }
+}
+
+void vsched_sleep(uint64_t ns) {
+    static uint32_t nobody;
+    vsched_wait_item it = { &nobody, 0 };
+    vsched_wait(&it, 1, ns);
+}
+
+void vsched_sleep_until(uint64_t deadline_ns) {
+    static uint32_t nobody;
+    vsched_wait_item it = { &nobody, 0 };
+    vsched_wait_until(&it, 1, deadline_ns);
+}
+
+void vsched_set_cpu_hz(uint64_t hz) {
+    g_cpu_hz = hz ? hz : DEFAULT_CPU_HZ;
+}
+
+uint64_t vsched_cpu_hz(void) {
+    return g_cpu_hz;
+}
+
+// Exact: the fraction of a nanosecond carries over, so a run's time does not
+// depend on how the instructions were batched.
+void vsched_cpu_charge(uint64_t instructions) {
+    g_cpu_frac += instructions * 1000000000ull;
+    g_now += g_cpu_frac / g_cpu_hz;
+    g_cpu_frac %= g_cpu_hz;
+    g_slice_left = instructions >= g_slice_left ? 0 : g_slice_left - instructions;
+}
+
+uint64_t vsched_cpu_remaining(void) {
+    return g_slice_left;
+}
+
+void vsched_cpu_slice_over(void) {
+    vsched_yield(0);
+}
+
+int vsched_slot(void) {
+    return g_cur ? g_cur->slot : 0;
+}
+
+void vsched_register_slot_reset(void (*fn)(int)) {
+    if (g_slot_reset_count >= 1024)
+        die("too many thread-local resetters");
+    g_slot_resets[g_slot_reset_count++] = fn;
+    fn(0);
+}
+
+void vsched_register_thread_exit(void (*fn)(int)) {
+    if (g_thread_exit_count >= 64)
+        die("too many thread-exit hooks");
+    g_thread_exits[g_thread_exit_count++] = fn;
+}
+
+int vsched_thread_count(void) {
+    return g_count;
+}
+
+uint32_t vsched_current_id(void) {
+    return g_cur ? g_cur->id : 0;
+}
+
+uint64_t vsched_switch_count(void) {
+    return g_switches;
+}
