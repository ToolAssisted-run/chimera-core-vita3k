+// 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+
+// The machine's threads, clock and waits. Upstream these are the host's;
+// in a Chimera core (CHIMERA) they are the machine's own scheduler and
+// virtual clock (chimera/sync.h), so a run does not depend on the host.
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <ctime>
+#include <condition_variable>
+#include <thread>
+
+#ifdef CHIMERA
+#include <chimera/sync.h>
+#endif
+
+namespace machine {
+
+#ifdef CHIMERA
+using condition_variable = chimera::condition_variable;
+using thread = chimera::thread;
+using clock = chimera::vclock;
+
+template <class Rep, class Period>
+inline void sleep_for(std::chrono::duration<Rep, Period> d) {
+    chimera::sleep_for(d);
+}
+inline void sleep_until(clock::time_point tp) {
+    chimera::sleep_until(tp);
+}
+inline void yield() {
+    chimera::yield();
+}
+#else
+using condition_variable = std::condition_variable;
+using thread = std::thread;
+using clock = std::chrono::steady_clock;
+
+template <class Rep, class Period>
+inline void sleep_for(std::chrono::duration<Rep, Period> d) {
+    std::this_thread::sleep_for(d);
+}
+inline void sleep_until(clock::time_point tp) {
+    std::this_thread::sleep_until(tp);
+}
+inline void yield() {
+    std::this_thread::yield();
+}
+#endif
+
+// The calendar: microseconds since the Unix epoch, and whole seconds (what
+// std::time gives upstream). In a Chimera core it is the machine's, starting
+// at a fixed date and carried forward by machine time.
+inline uint64_t calendar_us() {
+#ifdef CHIMERA
+    return vsched_calendar_us();
+#else
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::system_clock::now().time_since_epoch()).count());
+#endif
+}
+inline std::time_t calendar_time() {
+#ifdef CHIMERA
+    return static_cast<std::time_t>(vsched_calendar_us() / 1000000ull);
+#else
+    return std::time(nullptr);
+#endif
+}
+
+// Microseconds of machine time since the machine started (upstream: since
+// the host's clock epoch); differences are what callers use.
+inline uint64_t now_us() {
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::microseconds>(clock::now().time_since_epoch()).count());
+}
+
+} // namespace machine
