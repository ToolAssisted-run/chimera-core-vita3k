+// Chimera: sound with no host device. A port plays in machine time - each
+// keeps the moment its queued sound runs out - so a game that waits on its
+// audio waits exactly as long on every run. What it plays is kept for the
+// frontend to take a frame at a time.
+#pragma once
+
+#include "../state.h"
+
+#include <cstdint>
+#include <deque>
+
+class ChimeraAudioAdapter : public AudioAdapter {
+public:
+    explicit ChimeraAudioAdapter(AudioState &audio_state)
+        : AudioAdapter(audio_state) {}
+
+    bool init() override { return true; }
+    AudioOutPortPtr open_port(int nb_channels, int freq, int nb_sample) override;
+    void audio_output(AudioOutPort &out_port, const void *buffer) override;
+    void set_volume(AudioOutPort &out_port, float volume) override;
+    int get_rest_sample(AudioOutPort &out_port) override;
+    void wake_all_ports() override;
+};
+
+struct ChimeraAudioOutPort : public AudioOutPort {
+    int channels = 2;
+    // machine time (ns) when everything queued so far has played
+    uint64_t play_until = 0;
+    // what was played, interleaved S16 at `freq`, waiting to be taken
+    std::deque<int16_t> played;
+    float gain = 1.0f;
+    // a notify moves it, waking an output waiting out its buffer
+    uint32_t wake_seq = 0;
+};
