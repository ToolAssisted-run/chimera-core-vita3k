 }
 
 void rebuild_default_logger() {
+#ifdef CHIMERA
+    // Synchronous, with no duplicate filter: the log lives in the machine's
+    // filesystem, so what it holds, and when, may depend neither on a thread
+    // outside the machine's scheduler nor on the host's clock (the filter
+    // drops repeats by host seconds).
+    auto logger = std::make_shared<spdlog::logger>("vita3k logger", sinks.begin(), sinks.end());
+#else
     std::call_once(s_async_logging_once, []() {
         spdlog::init_thread_pool(ASYNC_LOG_QUEUE_SIZE, 1);
     });
@@ -172,6 +179,7 @@
         duplicate_filter,
         spdlog::thread_pool(),
         spdlog::async_overflow_policy::overrun_oldest);
+#endif
     spdlog::set_default_logger(std::move(logger));
     spdlog::set_pattern(LOG_PATTERN);
 }
