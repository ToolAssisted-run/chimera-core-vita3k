+#ifdef CHIMERA_GUEST
+// The sandbox delivers no signals: it calls the core's GuestFaultHandler on
+// the faulting thread for a page the guest protected, and that lands here.
+extern "C" bool chimera_mem_access_violation(uint8_t *addr, bool write) {
+    return access_violation_handler && access_violation_handler(addr, write);
+}
+
+static void register_access_violation_handler(const AccessViolationHandler &handler) {
+    access_violation_handler = handler;
+}
+#else
 static void register_access_violation_handler(const AccessViolationHandler &handler) {
