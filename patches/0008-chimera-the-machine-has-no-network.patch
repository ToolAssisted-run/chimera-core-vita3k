diff --git a/vita3k/net/include/net/socket.h b/vita3k/net/include/net/socket.h
--- a/vita3k/net/include/net/socket.h
+++ b/vita3k/net/include/net/socket.h
@@ -69,6 +69,40 @@
     virtual int get_socket_address(SceNetSockaddr *addr, unsigned int *addrlen) = 0;
 };
 
+#ifdef CHIMERA
+// Chimera: the machine has no network. A socket is still made - a Vita out
+// of range makes them too - but nothing is behind it: no host socket, and
+// every attempt to reach anything says the network is down.
+struct NoNetSocket : public Socket {
+    explicit NoNetSocket(int domain, int type, int protocol)
+        : Socket(domain, type, protocol) {}
+    int abort(int) override { return 0; }
+    int close() override { return 0; }
+    int shutdown_socket(int) override { return SCE_NET_ERROR_ENOTCONN; }
+    int bind(const SceNetSockaddr *, unsigned int) override { return 0; }
+    int send_packet(const void *, unsigned int, int, const SceNetSockaddr *, unsigned int) override { return SCE_NET_ERROR_ENETDOWN; }
+    int recv_packet(void *, unsigned int, int, SceNetSockaddr *, unsigned int *) override { return SCE_NET_ERROR_ENETDOWN; }
+    int set_socket_options(int, int, const void *, unsigned int) override { return 0; }
+    int get_socket_options(int, int, void *optval, unsigned int *optlen) override {
+        if (optval && optlen)
+            memset(optval, 0, *optlen);
+        return 0;
+    }
+    int connect(const SceNetSockaddr *, unsigned int) override { return SCE_NET_ERROR_ENETUNREACH; }
+    SocketPtr accept(SceNetSockaddr *, unsigned int *, int &err) override {
+        err = SCE_NET_ERROR_ENETDOWN;
+        return nullptr;
+    }
+    int listen(int) override { return 0; }
+    int get_peer_address(SceNetSockaddr *, unsigned int *) override { return SCE_NET_ERROR_ENOTCONN; }
+    int get_socket_address(SceNetSockaddr *addr, unsigned int *addrlen) override {
+        if (addr && addrlen)
+            memset(addr, 0, *addrlen);
+        return 0;
+    }
+};
+#endif
+
 // udp, tcp
 struct PosixSocket : public Socket {
     abs_socket sock;
