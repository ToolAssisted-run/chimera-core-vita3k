{
 "coreName": "Vita3K",
 "systemId": "PSV",
 "systemNames": {
  "PSV": "PlayStation Vita"
 },
 "author": "The Vita3K team; chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-vita3k",
 "romFile": "game",
 "deterministic": true,
 "memoryLayoutMiB": [
  1024,
  16,
  64,
  256,
  16384
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. The Vita's 4 GiB address space is one reservation on the mmap heap (only the pages the game touches cost anything), beside each guest thread's JIT code cache, the GPU's shadows and the machine's own filesystem - the installed system software, the game and its save data live in this memory, so a savestate carries what the game changed.",
 "video": {
  "_comment": "The Vita's screen, 960x544, drawn by Vita3K's OpenGL renderer through the GPU bridge or by its Vulkan renderer through the Vulkan bridge (the Renderer setting). 60 Hz exactly: the machine's vblank comes every 1/60 s of machine time (the hardware's is 59.94; Vita3K's own vblank thread runs at 60 too). width and height are the most the picture can be - 4x, the top of the Internal Resolution setting - and the core says what it is (GetVideoWidth, GetVideoHeight); the shape stays the screen's, 960x544.",
  "width": 3840,
  "height": 2176,
  "virtualWidth": 960,
  "virtualHeight": 544,
  "vsyncNumerator": 60,
  "vsyncDenominator": 1,
  "getBgra": "GetVideoBgra",
  "gpuStatesSurviveTheContext": true,
  "_comment_gpuStates": "Either renderer keeps the context id its objects were made in and builds every one again when the calls start landing on another (a state loaded in this session or a later one), and every picture the GPU finishes is written into the machine's memory, so a state holds the pictures too. The gate's fresh-process leg is the proof: saved at frame 150 in one process, the next is the same as one run."
 },
 "audio": {
  "_comment": "Every audio port mixed into one 48 kHz stereo stream at the machine time it plays: exactly 800 pairs a frame.",
  "rate": 48000,
  "samplesPerFrame": 2048,
  "channels": 2,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "input": {
  "name": "PlayStation Vita",
  "_comment": "The handheld's controls. The sticks run -128..127 with up and right positive. Each touch panel is its button plus a point (0..65535 across the panel, as every absolute position in Chimera is): the front panel covers the screen, the rear one the back. The accelerometer is in thousandths of a g (lying face up it reads -1000 on Z), the gyroscope in tenths of a degree a second. L and R are L1 and R1 to a game that asks the PS TV way.",
  "buttons": [
   "Up",
   "Down",
   "Left",
   "Right",
   "Cross",
   "Circle",
   "Square",
   "Triangle",
   "L",
   "R",
   "Start",
   "Select",
   "Front Touch",
   "Rear Touch"
  ],
  "mnemonics": {
   "Up": "U",
   "Down": "D",
   "Left": "L",
   "Right": "R",
   "Cross": "X",
   "Circle": "O",
   "Square": "Q",
   "Triangle": "T",
   "L": "l",
   "R": "r",
   "Start": "S",
   "Select": "s",
   "Front Touch": "F",
   "Rear Touch": "B"
  },
  "axes": [
   {
    "name": "Left Stick X",
    "min": -128,
    "max": 127,
    "neutral": 0,
    "header": "LSX"
   },
   {
    "name": "Left Stick Y",
    "min": -128,
    "max": 127,
    "neutral": 0,
    "header": "LSY"
   },
   {
    "name": "Right Stick X",
    "min": -128,
    "max": 127,
    "neutral": 0,
    "header": "RSX"
   },
   {
    "name": "Right Stick Y",
    "min": -128,
    "max": 127,
    "neutral": 0,
    "header": "RSY"
   },
   {
    "name": "Front Touch X",
    "min": 0,
    "max": 65535,
    "neutral": 32768,
    "header": "FTX"
   },
   {
    "name": "Front Touch Y",
    "min": 0,
    "max": 65535,
    "neutral": 32768,
    "header": "FTY"
   },
   {
    "name": "Rear Touch X",
    "min": 0,
    "max": 65535,
    "neutral": 32768,
    "header": "RTX"
   },
   {
    "name": "Rear Touch Y",
    "min": 0,
    "max": 65535,
    "neutral": 32768,
    "header": "RTY"
   },
   {
    "name": "Accel X",
    "min": -4000,
    "max": 4000,
    "neutral": 0,
    "header": "AX"
   },
   {
    "name": "Accel Y",
    "min": -4000,
    "max": 4000,
    "neutral": 0,
    "header": "AY"
   },
   {
    "name": "Accel Z",
    "min": -4000,
    "max": 4000,
    "neutral": -1000,
    "header": "AZ"
   },
   {
    "name": "Gyro X",
    "min": -18000,
    "max": 18000,
    "neutral": 0,
    "header": "GX"
   },
   {
    "name": "Gyro Y",
    "min": -18000,
    "max": 18000,
    "neutral": 0,
    "header": "GY"
   },
   {
    "name": "Gyro Z",
    "min": -18000,
    "max": 18000,
    "neutral": 0,
    "header": "GZ"
   }
  ]
 },
 "extensions": {
  ".vpk": "PSV"
 },
 "settings": [
  {
   "name": "renderer",
   "display": "setting.renderer",
   "type": "enum",
   "options": [
    "opengl-hw",
    "vulkan-hw"
   ],
   "default": "vulkan-hw",
   "description": "setting.renderer.about"
  },
  {
   "name": "internal_resolution",
   "display": "setting.internal_resolution",
   "type": "enum",
   "options": [
    "1x",
    "2x",
    "3x",
    "4x"
   ],
   "default": "1x",
   "description": "setting.internal_resolution.about"
  },
  {
   "name": "rendering_accuracy",
   "display": "setting.rendering_accuracy",
   "type": "enum",
   "options": [
    "standard",
    "high"
   ],
   "default": "standard",
   "description": "setting.rendering_accuracy.about"
  },
  {
   "name": "system_software",
   "display": "setting.system_software",
   "type": "enum",
   "options": [
    "full",
    "fonts",
    "none"
   ],
   "default": "full",
   "description": "setting.system_software.about"
  },
  {
   "name": "language",
   "display": "setting.language",
   "type": "enum",
   "options": [
    "japanese",
    "english-us",
    "french",
    "spanish",
    "german",
    "italian",
    "dutch",
    "portuguese-pt",
    "russian",
    "korean",
    "chinese-traditional",
    "chinese-simplified",
    "finnish",
    "swedish",
    "danish",
    "norwegian",
    "polish",
    "portuguese-br",
    "english-gb",
    "turkish"
   ],
   "default": "english-us",
   "description": "setting.language.about"
  },
  {
   "name": "enter_button",
   "display": "setting.enter_button",
   "type": "enum",
   "options": [
    "cross",
    "circle"
   ],
   "default": "cross",
   "description": "setting.enter_button.about"
  },
  {
   "name": "rtc_start",
   "display": "setting.rtc_start",
   "type": "int",
   "default": 1356998400,
   "min": 1262304000,
   "max": 2145916800,
   "description": "setting.rtc_start.about"
  },
  {
   "name": "cpu_mhz",
   "display": "setting.cpu_mhz",
   "type": "int",
   "default": 1332,
   "min": 333,
   "max": 4000,
   "description": "setting.cpu_mhz.about"
  },
  {
   "name": "ngs",
   "display": "setting.ngs",
   "type": "enum",
   "options": [
    "on",
    "off"
   ],
   "default": "on",
   "description": "setting.ngs.about"
  }
 ],
 "firmware": [
  {
   "id": "PSVUPDAT.PUP",
   "display": "firmware.psvupdat_pup",
   "name": "PSVUPDAT.PUP",
   "description": "firmware.psvupdat_pup.about",
   "requiredWhen": {
    "setting": "system_software",
    "is": "full"
   }
  },
  {
   "id": "PSP2UPDAT.PUP",
   "display": "firmware.psp2updat_pup",
   "name": "PSP2UPDAT.PUP",
   "description": "firmware.psp2updat_pup.about",
   "requiredWhen": {
    "setting": "system_software",
    "in": [
     "full",
     "fonts"
    ]
   }
  }
 ]
}
