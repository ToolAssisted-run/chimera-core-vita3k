 "extensions": {
  ".vpk": "PSV"
 },
 "settings": [
  {
   "name": "renderer",
   "display": "Renderer",
   "type": "enum",
   "options": [
    "opengl-hw"
   ],
   "default": "opengl-hw",
   "description": "How the picture is drawn. Vita3K's OpenGL renderer draws on your computer's graphics card, through the GPU bridge. It is the only renderer, because Vita3K has no software one, so this core cannot run on a computer that offers no OpenGL. What the graphics card draws is also written back into the Vita's memory (surface sync), so a savestate holds the pictures."
  },
  {
   "name": "internal_resolution",
   "display": "Internal Resolution",
   "type": "enum",
   "options": [
    "1x",
    "2x",
    "3x",
    "4x"
   ],
   "default": "1x",
   "description": "How many times the Vita's 960x544 resolution the graphics card draws at (Vita3K's Internal Resolution Upscaling). Above 1x the picture Chimera shows and records is the larger one, for example 1920x1088 at 2x. 3D shapes get finer edges. Text and images made for 960x544 are only enlarged. It is part of the machine. What the graphics card draws is written back into the Vita's memory at the Vita's own size, reduced from the larger picture, so those bytes differ from the ones a 1x picture leaves, and a game that reads its own picture can tell the difference. Measured on Alien Breed (1500 frames) and Alien Shooter (300 frames), the machine's timing, its thread switches and its sound are the same at 2x as at 1x. One limit: a savestate holds the picture at 960x544 and not the larger one, so in the first frame after a state is loaded the picture can be the small one enlarged. The machine itself is the same, and a movie played from the start is drawn at the chosen size throughout. Choose the resolution when the project is made, because an existing movie does not fit another resolution. Higher resolutions need more graphics power: 4x has sixteen times the pixels of 1x."
  },
  {
   "name": "system_software",
   "display": "System Software",
   "type": "enum",
   "options": [
    "full",
    "fonts",
    "none"
   ],
   "default": "full",
   "description": "Which of the Vita's system files are installed in the machine. Most games need the system software (PSVUPDAT.PUP, from PlayStation's update page) for its system libraries, and the font package (PSP2UPDAT.PUP) for the system fonts. 'Full' installs both. 'Fonts' installs only the font package. 'None' is for homebrew built with the Vita SDK, which needs neither. They are installed before the game starts, so they are part of the machine."
  },
  {
   "name": "language",
   "display": "System Language",
   "type": "enum",
   "options": [
    "japanese",
    "english-us",
    "french",
    "spanish",
    "german",
    "italian",
    "dutch",
    "portuguese-pt",
    "russian",
    "korean",
    "chinese-traditional",
    "chinese-simplified",
    "finnish",
    "swedish",
    "danish",
    "norwegian",
    "polish",
    "portuguese-br",
    "english-gb",
    "turkish"
   ],
   "default": "english-us",
   "description": "The console's system language. Games read it to choose their language, so it is part of the machine."
  },
  {
   "name": "enter_button",
   "display": "Enter Button",
   "type": "enum",
   "options": [
    "cross",
    "circle"
   ],
   "default": "cross",
   "description": "Which button confirms in the system's dialogs and in games that follow the system setting. It is Cross outside Japan and Circle on Japanese consoles. Games read it, so it is part of the machine."
  },
  {
   "name": "rtc_start",
   "display": "Clock at Power-On",
   "type": "int",
   "default": 1356998400,
   "min": 1262304000,
   "max": 2145916800,
   "description": "The date the console's clock shows when the game starts, in seconds since 1970. For example 1356998400 is 2013-01-01. After the start the clock runs with the emulated console and never with your computer. It is part of the machine. A game that picks its random numbers from the time plays differently with another date."
  },
  {
   "name": "cpu_mhz",
   "display": "CPU Clock (MHz)",
   "type": "int",
   "default": 1332,
   "min": 333,
   "max": 4000,
   "description": "How fast the console's processor runs. The game's code uses up emulated time at this speed. The default, 1332, is the Vita's three 444 MHz processor cores added together, counted at one instruction per cycle. It is part of the machine."
  },
  {
   "name": "ngs",
   "display": "NGS Audio",
   "type": "enum",
   "options": [
    "on",
    "off"
   ],
   "default": "on",
   "description": "Vita3K's 'Enable NGS Support' option. NGS is the Vita's sound library for games that mix their own sound. With it on, the core runs the library and those games have their sound. With it off, every NGS call returns at once without doing anything, and a game that uses NGS is silent or misses some sounds. It is on unless you turn it off here. Turn it off only for a game that hangs or crashes inside NGS, because Vita3K's NGS is not complete. What a game gets back from the library affects its timing (a game may wait for a sound to end), so it is part of the machine and a movie made with it off needs it off."
  }
 ],
 "firmware": [
  {
   "id": "PSVUPDAT.PUP",
   "display": "PS Vita system software (PSVUPDAT.PUP)",
   "name": "PSVUPDAT.PUP",
   "description": "The Vita's system software update, as PlayStation publishes it. Vita3K installs it before the game starts. The system libraries most games load come from it.",
   "requiredWhen": {
    "setting": "system_software",
    "is": "full"
   }
  },
  {
   "id": "PSP2UPDAT.PUP",
   "display": "PS Vita font package (PSP2UPDAT.PUP)",
   "name": "PSP2UPDAT.PUP",
   "description": "The Vita's font package. Vita3K installs it before the game starts. Games that draw text with the system fonts need it.",
   "requiredWhen": {
    "setting": "system_software",
    "in": [
     "full",
     "fonts"
    ]
   }
  }
 ]
}
