{
 "coreName": "Vita3K",
 "systemId": "PSV",
 "author": "The Vita3K team; chimera port by Sergio Martin",
 "url": "https://github.com/ToolAssisted-run/chimera-core-vita3k",
 "romFile": "game",
 "deterministic": true,
 "memoryLayoutMiB": [
  1024,
  16,
  64,
  256,
  16384
 ],
 "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. The Vita's 4 GiB address space is one reservation on the mmap heap (only the pages the game touches cost anything), beside each guest thread's JIT code cache, the GPU's shadows and the machine's own filesystem - the installed system software, the game and its save data live in this memory, so a savestate carries what the game changed.",
 "video": {
  "_comment": "The Vita's screen, 960x544, drawn by Vita3K's OpenGL renderer through the GPU bridge. 60 Hz exactly: the machine's vblank comes every 1/60 s of machine time (the hardware's is 59.94; Vita3K's own vblank thread runs at 60 too).",
  "width": 960,
  "height": 544,
  "virtualWidth": 960,
  "virtualHeight": 544,
  "vsyncNumerator": 60,
  "vsyncDenominator": 1,
  "getBgra": "GetVideoBgra",
  "gpuStatesSurviveTheContext": true,
  "_comment_gpuStates": "The renderer keeps the context id its GL objects were made in and builds every one again when the calls start landing on another (a state loaded in this session or a later one), and surface sync writes every picture the GPU finishes into the machine's memory, so a state holds the pictures too. The gate's fresh-process leg is the proof: saved at frame 150 in one process, the next is the same as one run."
 },
 "audio": {
  "_comment": "Every audio port mixed into one 48 kHz stereo stream at the machine time it plays: exactly 800 pairs a frame.",
  "rate": 48000,
  "samplesPerFrame": 2048,
  "channels": 2,
  "get": "GetAudio"
 },
 "lag": {
  "inputWasRead": "InputWasRead"
 },
 "input": {
  "name": "PlayStation Vita",
  "_comment": "The handheld's controls. The sticks run -128..127 with up and right positive. Each touch panel is its button plus a point (0..65535 across the panel, as every absolute position in Chimera is): the front panel covers the screen, the rear one the back. The accelerometer is in thousandths of a g (lying face up it reads -1000 on Z), the gyroscope in tenths of a degree a second. L and R are L1 and R1 to a game that asks the PS TV way.",
  "buttons": [
   "Up",
   "Down",
   "Left",
   "Right",
   "Cross",
   "Circle",
   "Square",
   "Triangle",
   "L",
   "R",
   "Start",
   "Select",
   "Front Touch",
   "Rear Touch"
  ],
  "axes": [
   {
    "name": "Left Stick X",
    "min": -128,
    "max": 127,
    "neutral": 0
   },
   {
    "name": "Left Stick Y",
    "min": -128,
    "max": 127,
    "neutral": 0
   },
   {
    "name": "Right Stick X",
    "min": -128,
    "max": 127,
    "neutral": 0
   },
   {
    "name": "Right Stick Y",
    "min": -128,
    "max": 127,
    "neutral": 0
   },
   {
    "name": "Front Touch X",
    "min": 0,
    "max": 65535,
    "neutral": 32768
   },
   {
    "name": "Front Touch Y",
    "min": 0,
    "max": 65535,
    "neutral": 32768
   },
   {
    "name": "Rear Touch X",
    "min": 0,
    "max": 65535,
    "neutral": 32768
   },
   {
    "name": "Rear Touch Y",
    "min": 0,
    "max": 65535,
    "neutral": 32768
   },
   {
    "name": "Accel X",
    "min": -4000,
    "max": 4000,
    "neutral": 0
   },
   {
    "name": "Accel Y",
    "min": -4000,
    "max": 4000,
    "neutral": 0
   },
   {
    "name": "Accel Z",
    "min": -4000,
    "max": 4000,
    "neutral": -1000
   },
   {
    "name": "Gyro X",
    "min": -18000,
    "max": 18000,
    "neutral": 0
   },
   {
    "name": "Gyro Y",
    "min": -18000,
    "max": 18000,
    "neutral": 0
   },
   {
    "name": "Gyro Z",
    "min": -18000,
    "max": 18000,
    "neutral": 0
   }
  ]
 },
 "extensions": {
  ".vpk": "PSV"
 },
 "settings": [
  {
   "name": "renderer",
   "display": "Renderer",
   "type": "enum",
   "options": [
    "opengl-hw"
   ],
   "default": "opengl-hw",
   "description": "How the picture is drawn: Vita3K's OpenGL renderer on this machine's GPU, through the GPU bridge. It is the only one - Vita3K has no software renderer - so a machine that cannot give an OpenGL context cannot run this core. With surface sync on, what the GPU draws is written back to the machine's memory, so a state holds the pictures."
  },
  {
   "name": "system_software",
   "display": "System Software",
   "type": "enum",
   "options": [
    "full",
    "fonts",
    "none"
   ],
   "default": "full",
   "description": "Which of the Vita's own software the machine has installed. Most games need the system software (PSVUPDAT.PUP, from PlayStation's update page) for the system libraries it carries, and the font package (PSP2UPDAT.PUP) for the system fonts; Full installs both. Fonts installs only the font package. None is for homebrew built with the Vita SDK, which needs neither. Both are installed before the game starts, so they are part of the machine."
  },
  {
   "name": "language",
   "display": "System Language",
   "type": "enum",
   "options": [
    "japanese",
    "english-us",
    "french",
    "spanish",
    "german",
    "italian",
    "dutch",
    "portuguese-pt",
    "russian",
    "korean",
    "chinese-traditional",
    "chinese-simplified",
    "finnish",
    "swedish",
    "danish",
    "norwegian",
    "polish",
    "portuguese-br",
    "english-gb",
    "turkish"
   ],
   "default": "english-us",
   "description": "The console's language system parameter. Games read it to pick their language, so it shapes the machine."
  },
  {
   "name": "enter_button",
   "display": "Enter Button",
   "type": "enum",
   "options": [
    "cross",
    "circle"
   ],
   "default": "cross",
   "description": "Which button confirms in the system's dialogs and in the games that follow the system setting: Cross outside Japan, Circle on Japanese consoles. Games read it, so it shapes the machine."
  },
  {
   "name": "rtc_start",
   "display": "Clock at Power-On",
   "type": "int",
   "default": 1356998400,
   "min": 1262304000,
   "max": 2145916800,
   "description": "The date the console's clock shows when the game starts, in seconds since 1970 (1356998400 is 2013-01-01). The clock then runs with the machine, never with the host. Part of the machine: a game that seeds its random numbers from the time plays differently under another date."
  },
  {
   "name": "cpu_mhz",
   "display": "CPU Clock (MHz)",
   "type": "int",
   "default": 1332,
   "min": 333,
   "max": 4000,
   "description": "How fast the machine's processor runs: the game's own code buys machine time at this rate. 1332 is the Vita's three 444 MHz Cortex-A9 cores' worth at one instruction a cycle, charged on one timeline. Part of the machine."
  }
 ],
 "firmware": [
  {
   "id": "PSVUPDAT.PUP",
   "display": "PS Vita system software (PSVUPDAT.PUP)",
   "name": "PSVUPDAT.PUP",
   "description": "The Vita's system software update, as PlayStation publishes it. Vita3K installs it before the game starts: the system libraries most games load come from it.",
   "requiredWhen": {
    "setting": "system_software",
    "is": "full"
   }
  },
  {
   "id": "PSP2UPDAT.PUP",
   "display": "PS Vita font package (PSP2UPDAT.PUP)",
   "name": "PSP2UPDAT.PUP",
   "description": "The Vita's font package. Vita3K installs it before the game starts: games that draw text with the system fonts need it.",
   "requiredWhen": {
    "setting": "system_software",
    "in": [
     "full",
     "fonts"
    ]
   }
  }
 ]
}
